            <mxPoint x="120" y="405" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v63" value="R101 changes its own status; nothing is deleted. It stays in the store as Cancelled, so it no longer blocks R7 for 12–14 Nov and the history is kept. Find (2) must come before Cancel (4)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="910" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
